  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "bundle",
    "superpowers",
    "skills",
    "tdd",
    "coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
